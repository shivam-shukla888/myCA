# ==============================================================================
# PERSONAL AI CA — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure real values. DO NOT COMMIT .env TO GIT.
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=production

# Supabase Production Configuration (PostgreSQL + Auth + Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Field-Level Encryption & HMAC Audit Signatures (32-byte / 64-character hex key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_SECRET_KEY=replace_with_64_character_hex_string

# Cross-Origin Resource Sharing (CORS) — Set to your production frontend domain
CORS_ORIGIN=https://your-domain.vercel.app

# Primary Canonical AI Configuration (Google Gemini)
GEMINI_API_KEY=your_google_gemini_api_key

# Secondary Failover AI Configuration (SambaNova / Groq)
PRIMARY_AI_API_KEY=your_sambanova_api_key
PRIMARY_AI_BASE_URL=https://api.sambanova.ai/v1
PRIMARY_AI_MODEL=Meta-Llama-3.3-70B-Instruct

GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Security & Redirection Allowed Origins (Comma-separated)
ALLOWED_REDIRECT_URLS=https://your-domain.vercel.app,http://localhost:3000

# Error Monitoring (Sentry DSN)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
