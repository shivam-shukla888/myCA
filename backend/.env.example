# Server Configuration
PORT=4000
NODE_ENV=development

# Supabase Configuration
SUPABASE_URL=https://pesvgxqpdeeyhjvqoaip.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Primary AI Provider Configuration
PRIMARY_AI_API_KEY=your_primary_ai_key_here
PRIMARY_AI_BASE_URL=https://api.sambanova.ai/v1
PRIMARY_AI_MODEL=Meta-Llama-3.3-70B-Instruct

# Fallback AI Provider Configuration (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Application-level Encryption (AES-256 for PAN / GSTIN)
ENCRYPTION_SECRET_KEY=replace_with_32_byte_hex_or_base64_secret_key

# CORS Settings
CORS_ORIGIN=http://localhost:3000
